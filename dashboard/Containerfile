ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY dashboard/serve.py /app/serve.py
RUN chmod 0444 /app/serve.py
USER 1001
EXPOSE 8080
CMD ["python", "/app/serve.py", "--html", "/snapshot/index.html", "--host", "0.0.0.0", "--port", "8080"]
